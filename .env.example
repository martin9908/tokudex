# TokuDex environment variables — copy to .env.local and fill in.
# Get values from Supabase → Settings → API.

# Public (safe to expose to the browser; per-user safety relies on RLS being ON):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical production origin (no trailing slash) — used for SEO metadata,
# sitemap, robots, canonical URLs, and Open Graph images. Defaults to the
# Vercel URL if unset. Set to your real domain in production.
NEXT_PUBLIC_SITE_URL=https://tokudex.vercel.app

# Server-only secret — used for account deletion (auth.admin.deleteUser).
# NEVER prefix with NEXT_PUBLIC_ and never expose to the client.
# Also add this to the Vercel project's Environment Variables.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: your Ko-fi page URL (e.g. https://ko-fi.com/yourname). When set, a
# "Support TokuDex" link appears in the app. Leave blank to hide it.
NEXT_PUBLIC_KOFI_URL=
